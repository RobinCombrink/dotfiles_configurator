# The schema is regenerated by the build script, which writes LF. Without this, core.autocrlf
# checks it out with CRLF, the build rewrites it on every run, and the working tree is dirty
# after every `cargo build`.
schema/configuration_schema.json text eol=lf

# The migration fixtures are compared byte for byte against what a writeback produces, and a
# writeback writes LF. Without this, core.autocrlf checks them out with CRLF and the comparison
# fails on Windows while passing on a Linux build agent.
tests/fixtures/*.dotconfig.json text eol=lf
