{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Configuration",
  "type": "object",
  "required": [
    "clone_config",
    "dotfiles_repository",
    "downloads",
    "git_clones",
    "version"
  ],
  "properties": {
    "cli_commands": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/definitions/CliCommand"
      }
    },
    "clone_config": {
      "$ref": "#/definitions/GitCloneConfig"
    },
    "dotfiles": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/definitions/DetailsType"
      }
    },
    "dotfiles_repository": {
      "$ref": "#/definitions/GitClone"
    },
    "downloads": {
      "$ref": "#/definitions/Downloads"
    },
    "git_clones": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/GitClone"
      }
    },
    "version": {
      "type": "string"
    }
  },
  "definitions": {
    "ApplicationDetails": {
      "type": "object",
      "required": [
        "name",
        "uri"
      ],
      "properties": {
        "dotfiles": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/definitions/DetailsType"
          }
        },
        "name": {
          "type": "string"
        },
        "uri": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "CliCommand": {
      "type": "object",
      "required": [
        "args",
        "interactive"
      ],
      "properties": {
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "interactive": {
          "type": "boolean"
        }
      }
    },
    "DetailsType": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "file"
          ],
          "properties": {
            "file": {
              "$ref": "#/definitions/FileDetails"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "directory"
          ],
          "properties": {
            "directory": {
              "$ref": "#/definitions/DirectoryDetails"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "DirectoryDetails": {
      "type": "object",
      "required": [
        "link_path",
        "original_path"
      ],
      "properties": {
        "link_path": {
          "type": "string"
        },
        "original_path": {
          "type": "string"
        }
      }
    },
    "Downloads": {
      "type": "object",
      "required": [
        "applications",
        "github_releases"
      ],
      "properties": {
        "applications": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ApplicationDetails"
          }
        },
        "github_releases": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/RepositoryDetails"
          }
        }
      }
    },
    "FileDetails": {
      "type": "object",
      "required": [
        "file_name",
        "original_path"
      ],
      "properties": {
        "file_name": {
          "type": "string"
        },
        "link_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "original_path": {
          "type": "string"
        }
      }
    },
    "GitClone": {
      "type": "object",
      "required": [
        "owner",
        "repo"
      ],
      "properties": {
        "cli_commands": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/definitions/CliCommand"
          }
        },
        "owner": {
          "type": "string"
        },
        "repo": {
          "type": "string"
        }
      }
    },
    "GitCloneConfig": {
      "type": "object",
      "required": [
        "github_username",
        "repositories_directory_path"
      ],
      "properties": {
        "github_username": {
          "description": "The username used when making requests to github",
          "type": "string"
        },
        "repositories_directory_path": {
          "description": "Absolute path of directory to clone into",
          "type": "string"
        }
      }
    },
    "RepositoryDetails": {
      "type": "object",
      "anyOf": [
        {
          "type": "object",
          "required": [
            "asset_exact"
          ],
          "properties": {
            "asset_exact": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "asset_contains"
          ],
          "properties": {
            "asset_contains": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "asset_ends_with"
          ],
          "properties": {
            "asset_ends_with": {
              "type": "string"
            }
          }
        }
      ],
      "required": [
        "owner",
        "repo"
      ],
      "properties": {
        "commands": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/definitions/CliCommand"
          }
        },
        "dotfiles": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/definitions/DetailsType"
          }
        },
        "owner": {
          "type": "string"
        },
        "repo": {
          "type": "string"
        }
      }
    }
  }
}