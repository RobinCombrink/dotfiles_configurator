{
    "version": "8",
    "applies_to": "personal",
    "github_account": "Alice",
    "estate": {
        "name": "personal"
    },
    "workspaces": [
        {
            "repository": {
                "owner": "Alice",
                "repository": "dotfiles"
            }
        }
    ],
    "resources": [
        {
            "kind": "symlink",
            "source_path": "gitconfig/.gitconfig",
            "link_path": ".gitconfig"
        },
        {
            "kind": "package",
            "manager": "winget",
            "id": "Microsoft.PowerShell"
        },
        {
            "kind": "repository",
            "owner": "Alice",
            "repository": "notes"
        },
        {
            "kind": "application",
            "shape": "installer",
            "name": "Docker Desktop",
            "source": {
                "source": "uri",
                "uri": "https://example.invalid/docker.exe",
                "installer_file_name": "docker.exe"
            },
            "presence_check": {
                "check": "path_exists",
                "paths": [
                    "Programs/Docker"
                ]
            }
        }
    ],
    "notices": [
        "Sync the Android Studio settings repository"
    ]
}
