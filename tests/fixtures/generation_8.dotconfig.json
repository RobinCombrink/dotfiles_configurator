{
    "version": "8",
    "applies_to": "personal",
    "github_account": "Alice",
    "estate": {
        "name": "personal"
    },
    "workspaces": [
        {
            "repository": {
                "owner": "Alice",
                "repository": "dotfiles"
            }
        }
    ],
    "resources": [
        {
            "kind": "symlink",
            "source_path": "gitconfig/.gitconfig",
            "link_path": ".gitconfig"
        },
        {
            "kind": "package",
            "manager": "winget",
            "id": "Microsoft.PowerShell"
        },
        {
            "kind": "repository",
            "owner": "Alice",
            "repository": "notes"
        },
        {
            "kind": "application",
            "shape": "installer",
            "name": "Docker Desktop",
            "source": {
                "source": "uri",
                "uri": "https://example.invalid/docker.exe",
                "installer_file_name": "docker.exe"
            },
            "presence_check": {
                "check": "path_exists",
                "paths": [
                    "Programs/Docker"
                ]
            }
        },
        {
            "kind": "environment_variable",
            "shape": "variable",
            "name": "EDITOR",
            "value": "nvim"
        },
        {
            "kind": "environment_variable",
            "shape": "search_path_entry",
            "directory": {
                "in": "repository",
                "repository": {
                    "owner": "flutter",
                    "repository": "flutter"
                },
                "path": "bin"
            }
        },
        {
            "kind": "registration",
            "registry": "claude_mcp_server",
            "name": "serena",
            "scope": "user",
            "command": "uvx",
            "args": [
                "serena"
            ],
            "environment": {}
        },
        {
            "kind": "command",
            "shell": "bash",
            "args": [
                "wsl --install"
            ],
            "presence_check": {
                "check": "command_on_path",
                "command": "wsl"
            }
        }
    ],
    "notices": [
        "Sync the Android Studio settings repository"
    ]
}
