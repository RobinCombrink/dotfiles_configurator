{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [

        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug executable 'dotfiles'",
            "cargo": {
                "args": [
                    "build",
                    "--bin=dotfiles",
                    "--package=dotfiles"
                ],
                "filter": {
                    "name": "dotfiles",
                    "kind": "bin"
                }
            },
            "args": ["--dry-run", "local"],
            "cwd": "${workspaceFolder}"
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug unit tests in executable 'dotfiles'",
            "cargo": {
                "args": [
                    "test",
                    "--no-run",
                    "--bin=dotfiles",
                    "--package=dotfiles"
                ],
                "filter": {
                    "name": "dotfiles",
                    "kind": "bin"
                }
            },
            "args": [],
            "cwd": "${workspaceFolder}"
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug integration test 'cli_commands'",
            "cargo": {
                "args": [
                    "test",
                    "--no-run",
                    "--test=cli_commands",
                    "--package=dotfiles"
                ],
                "filter": {
                    "name": "cli_commands",
                    "kind": "test"
                }
            },
            "args": [],
            "cwd": "${workspaceFolder}"
        }
    ]
}